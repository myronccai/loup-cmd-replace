@mode(host.dual)

# The two interactive bits of replace: /W waits for a key, /P asks Y/N.
# Loup 1.26.0 reads standard input only as a whole, so a child `sh` reads
# what is needed and no more: one key (raw mode on a terminal, one byte
# otherwise) or one line.
#
# Runtime: host.dual. Compiled into the native binary build/replace by `make
# build`; `make run` interprets the same code with Stage0 (`loup-bootstrap run
# source/main.loup`). It calls exec(); the self-hosted `loup run` of Loup
# 1.26.0 joins exec() arguments into one shell line without quoting, which
# breaks these calls, so `make run` uses Stage0.

const READ_KEY: string = "if [ -t 0 ]; then s=$(stty -g); stty -icanon -echo min 1; dd bs=1 count=1 >/dev/null 2>&1; stty \"$s\"; else dd bs=1 count=1 >/dev/null 2>&1; fi";

# Prints `1` or `0` (stdin is a terminal or not), then the line read; fails
# at the end of the input.
const READ_LINE: string = "if [ -t 0 ]; then t=1; else t=0; fi; IFS= read -r a; s=$?; printf '%s%s' \"$t\" \"$a\"; [ $s -eq 0 ] || [ -n \"$a\" ]";

pub const MSG_PRESS_KEY: string = "Press any key to continue . . .";

# /W: waits for one key (or one byte of piped input; the end of the input
# is fine too).
pub func wait_for_key(): void {
    print(MSG_PRESS_KEY);
    exec(["sh", "-c", READ_KEY]);
    println("");
}

# How an answer reads: 1 yes, 0 no, -1 neither.
pub func answer_value(line: string): int {
    let a = line.trim().toUpperCase();
    if (a.startsWith("Y")) {
        return 1;
    }
    if (a.startsWith("N")) {
        return 0;
    }
    return -1;
}

# What is echoed after a piped answer (a terminal echoes it itself).
pub func answer_echo(line: string): string {
    let value = answer_value(line);
    if (value == 1) {
        return "Y";
    }
    if (value == 0) {
        return "N";
    }
    return line.trim();
}

# /P: prints the question and reads answers until one starts with Y or N
# (the question is always asked once, hence do/while). The end of the input
# counts as No.
pub func ask_yes_no(question: string): bool {
    var value = -1;
    do {
        print(question);
        let r = exec(["sh", "-c", READ_LINE]);
        let out = r.stdout.to_string();
        if (r.exit_code != 0) {
            println("");
            return false;
        }
        let line = out.slice(1);
        if (!out.startsWith("1")) {
            println(answer_echo(line));
        }
        value = answer_value(line);
    } while (value < 0);
    return value == 1;
}
