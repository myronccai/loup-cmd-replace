@mode(host.dual)

# Application identity for replace: name, version, summary and the exit
# statuses (replace's ERRORLEVELs). Keep APP_NAME and APP_VERSION in step
# with `name` and `version` in package.lppkg.
#
# Runtime: host.dual. Constants only. Compiled into build/replace by `make
# build`; `make run` interprets the same code with Stage0 (`loup-bootstrap run
# source/main.loup`).

pub const APP_NAME: string = "replace";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Replace or add files in a directory (a Loup recreation of the Windows replace command).";

# Exit statuses returned by main(): replace's ERRORLEVELs.
pub const EXIT_OK: int = 0;
pub const EXIT_NO_FILES: int = 2;       # no source file matches
pub const EXIT_PATH_NOT_FOUND: int = 3; # a source or destination directory is missing
pub const EXIT_ACCESS_DENIED: int = 5;  # a read-only file without /R, or a failed copy
pub const EXIT_USAGE: int = 11;         # a command-line error
