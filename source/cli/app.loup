@mode(host.dual)

# Top level of replace: parse the arguments, handle /? and --version, run
# the command and turn the outcome into replace's ERRORLEVEL.
#
# Runtime: host.dual. Compiled into the native binary build/replace by `make
# build`; `make run` interprets the same code with Stage0 (`loup-bootstrap run
# source/main.loup`). The unit tests call run() directly.

from appinfo import (EXIT_OK, EXIT_USAGE, EXIT_ACCESS_DENIED);
from cli.args import (parse_args);
from cli.usage import (usage, version_line);
from commands.replace import (run_replace);

# Parses argv, runs replace and returns the exit status (cmd's ERRORLEVEL).
pub func run(argv: list[string]): int {
    let opts = match parse_args(argv) {
        Ok(parsed) => parsed,
        Err(msg) => {
            printErr(msg);
            return EXIT_USAGE;
        },
    };

    if (opts.help) {
        println(usage());
        return EXIT_OK;
    }
    if (opts.version) {
        println(version_line());
        return EXIT_OK;
    }

    try {
        return run_replace(opts);
    } catch (Exception as e) {
        printErr(e.message);
        return EXIT_ACCESS_DENIED;
    }
}
